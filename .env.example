# ---- backend/.env ----
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tapetrend
TWELVEDATA_KEY=            # optional, free at twelvedata.com
NEWSAPI_KEY=               # optional, free at newsapi.org
ANTHROPIC_API_KEY=         # optional, enables Claude AI analysis (falls back to Ollama, then rules)
OLLAMA_URL=http://localhost:11434   # optional, local LLM fallback — `ollama pull llama3`
OLLAMA_MODEL=llama3        # set empty to skip the local-LLM path entirely
OLLAMA_TIMEOUT=180         # seconds; an 8B model on CPU takes ~30s warm, longer cold
CORS_ORIGINS=http://localhost:3000
